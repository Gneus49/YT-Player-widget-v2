<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Minimal YouTube Widget</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { user-select: none; }
        ::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="bg-black text-white h-screen flex items-center justify-center p-3 font-sans">

    <!-- YouTube IFrame Container -->
    <div id="yt-player-container" class="hidden">
        <div id="yt-player"></div>
    </div>

    <!-- Main Widget Interface -->
    <div class="w-full max-w-[390px] h-[280px] bg-neutral-900 rounded-[28px] overflow-hidden shadow-2xl border border-neutral-800 flex flex-col relative">
        
        <!-- Background Overlay for Richer UI -->
        <div class="absolute inset-0 bg-gradient-to-br from-neutral-900 to-black z-0"></div>
        
        <!-- Main Content Area -->
        <div class="relative z-10 flex-grow p-5 flex flex-col justify-between">
            
            <!-- Top Section: Thumbnail and Track Info -->
            <div class="flex items-center space-x-4">
                <!-- Thumbnail -->
                <div class="w-[100px] h-[100px] rounded-2xl overflow-hidden shadow-lg flex-shrink-0 bg-neutral-800 relative group">
                    <img id="track-thumbnail" src="https://placeholder.pics/svg/100" alt="Thumbnail" class="w-full h-full object-cover">
                    <!-- Subtle playing indicator overlay -->
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center">
                            <div class="w-3 h-3 bg-white rounded-full"></div>
                        </div>
                    </div>
                </div>
                
                <!-- Track Details -->
                <div class="flex-1 min-w-0 pr-2">
                    <h2 id="track-title" class="text-lg font-bold truncate leading-tight text-white mb-1 drop-shadow-md">
                        Loading...
                    </h2>
                    <p id="track-channel" class="text-sm text-neutral-400 truncate font-medium">
                        Please add a video
                    </p>
                    <div class="mt-2 inline-flex items-center bg-white/10 backdrop-blur-md rounded-full px-2 py-0.5 border border-white/5">
                        <span class="w-2 h-2 rounded-full bg-neutral-500 mr-2"></span>
                        <span class="text-xs font-semibold uppercase tracking-wider text-neutral-300">Ready</span>
                    </div>
                </div>
            </div>

            <!-- Middle Section: Timeline/Scrubber -->
            <div class="space-y-1">
                <div class="flex justify-between text-xs font-medium text-neutral-400 tracking-wide">
                    <span id="current-time">0:00</span>
                    <span id="total-duration">0:00</span>
                </div>
                <!-- Custom Range Slider -->
                <div class="relative h-2 flex items-center">
                    <input id="progress-bar" type="range" min="0" max="100" value="0" class="w-full h-1.5 bg-neutral-700 rounded-lg appearance-none cursor-pointer focus:outline-none [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-3 [&::-webkit-slider-thumb]:h-3 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-white [&::-webkit-slider-thumb]:transition-all [&::-webkit-slider-thumb]:hover:scale-125">
                </div>
            </div>

            <!-- Bottom Section: Controls -->
            <div class="flex items-center justify-between pb-1">
                <!-- Previous -->
                <button id="prev-btn" class="w-10 h-10 flex items-center justify-center rounded-full bg-neutral-800/80 backdrop-blur-md hover:bg-neutral-700 active:scale-95 transition-all text-white border border-white/5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12.75 3.75v16.5m-4.5-16.5v16.5"/></svg>
                </button>
                
                <!-- Rewind 10s -->
                <button id="rewind-btn" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-neutral-800 active:scale-95 transition-all text-neutral-300 hover:text-white">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>
                </button>

                <!-- Play/Pause -->
                <button id="play-pause-btn" class="w-14 h-14 flex items-center justify-center rounded-full bg-white text-black hover:scale-105 active:scale-95 transition-all shadow-lg shadow-white/10">
                    <svg id="play-icon" class="w-6 h-6 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    <!-- Pause Icon (Hidden by default) -->
                    <svg id="pause-icon" class="w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                </button>

                <!-- Forward 10s -->
                <button id="forward-btn" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-neutral-800 active:scale-95 transition-all text-neutral-300 hover:text-white">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l6-9m0 0l-6-9m6 9H9a6 6 0 000 12h3"/></svg>
                </button>

                <!-- Next -->
                <button id="next-btn" class="w-10 h-10 flex items-center justify-center rounded-full bg-neutral-800/80 backdrop-blur-md hover:bg-neutral-700 active:scale-95 transition-all text-white border border-white/5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 4.5l7.5 7.5-7.5 7.5m-6-15l7.5 7.5-7.5 7.5"/></svg>
                </button>
            </div>
            
        </div>
    </div>

    <!-- YouTube IFrame API Script -->
    <script>
        // Load YouTube IFrame Player API
        const tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        const firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

        let player;
        const playlist = [
            'jfKFPfjrDkQ', // Lofi Girl 1
            'DWcJFNfIVWE', // Lofi Girl 2
            'A6wXfbS1Sjk'  // Lofi Girl 3
        ];
        let currentTrackIndex = 0;

        // API Ready Callback
        function onYouTubeIframeAPIReady() {
            player = new YT.Player('yt-player', {
                height: '0',
                width: '0',
                videoId: playlist[currentTrackIndex],
                playerVars: {
                    'autoplay': 0,
                    'controls': 0,
                    'disablekb': 1,
                    'fs': 0,
                    'iv_load_policy': 3,
                    'rel': 0
                },
                events: {
                    'onReady': onPlayerReady,
                    'onStateChange': onPlayerStateChange
                }
            });
        }

        // Initialize UI after Player is Ready
        function onPlayerReady(event) {
            updateTrackInfo();
            startTimer();
        }

        // Handle Player State Changes
        function onPlayerStateChange(event) {
            const playIcon = document.getElementById('play-icon');
            const pauseIcon = document.getElementById('pause-icon');

            if (event.data === YT.PlayerState.PLAYING) {
                playIcon.classList.add('hidden');
                pauseIcon.classList.remove('hidden');
                document.getElementById('track-thumbnail').parentElement.classList.add('animate-pulse');
            } else {
                playIcon.classList.remove('hidden');
                pauseIcon.classList.add('hidden');
                document.getElementById('track-thumbnail').parentElement.classList.remove('animate-pulse');
            }

            // Auto-advance to next track when video ends
            if (event.data === YT.PlayerState.ENDED) {
                nextTrack();
            }
        }

        // Update UI Elements
        function updateTrackInfo() {
            const videoId = playlist[currentTrackIndex];
            
            // Set Thumbnail
            const thumbUrl = `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
            document.getElementById('track-thumbnail').src = thumbUrl;

            // Fetch Video Title using oEmbed (simulated via placeholder logic for simplicity here)
            // In a production PWA, you fetch this from YouTube Data API with an API Key
            document.getElementById('track-title').innerText = "Lo-Fi Beats to Study/Relax";
            document.getElementById('track-channel').innerText = "Lofi Girl Radio";
            
            // Update Duration
            setTimeout(() => {
                const duration = player.getDuration();
                document.getElementById('total-duration').innerText = formatTime(duration);
            }, 1000);
        }

        // Control Functions
        document.getElementById('play-pause-btn').addEventListener('click', () => {
            const playerState = player.getPlayerState();
            if (playerState === YT.PlayerState.PLAYING) {
                player.pauseVideo();
            } else {
                player.playVideo();
            }
        });

        document.getElementById('rewind-btn').addEventListener('click', () => {
            const currentTime = player.getCurrentTime();
            player.seekTo(currentTime - 10, true);
        });

        document.getElementById('forward-btn').addEventListener('click', () => {
            const currentTime = player.getCurrentTime();
            player.seekTo(currentTime + 10, true);
        });

        document.getElementById('prev-btn').addEventListener('click', () => {
            prevTrack();
        });

        document.getElementById('next-btn').addEventListener('click', () => {
            nextTrack();
        });

        function nextTrack() {
            currentTrackIndex = (currentTrackIndex + 1) % playlist.length;
            player.loadVideoById(playlist[currentTrackIndex]);
            updateTrackInfo();
        }

        function prevTrack() {
            currentTrackIndex = (currentTrackIndex - 1 + playlist.length) % playlist.length;
            player.loadVideoById(playlist[currentTrackIndex]);
            updateTrackInfo();
        }

        // Progress Bar Interaction
        const progressBar = document.getElementById('progress-bar');
        
        progressBar.addEventListener('input', (e) => {
            const seekTo = (player.getDuration() * (e.target.value / 100));
            player.seekTo(seekTo, true);
        });

        // Timer to update progress bar and time
        function startTimer() {
            setInterval(() => {
                if (player && player.getPlayerState() === YT.PlayerState.PLAYING) {
                    const currentTime = player.getCurrentTime();
                    const duration = player.getDuration();
                    
                    // Update Time Text
                    document.getElementById('current-time').innerText = formatTime(currentTime);
                    
                    // Update Progress Bar
                    const progress = (currentTime / duration) * 100;
                    progressBar.value = progress;
                }
            }, 500);
        }

        // Helper: Format Seconds to MM:SS
        function formatTime(seconds) {
            const mins = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }
    </script>
</body>
</html>
